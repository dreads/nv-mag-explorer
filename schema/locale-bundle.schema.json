{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dreads/nv-mag-explorer/main/schema/locale-bundle.schema.json",
  "title": "NV Magnetometry locale bundle",
  "description": "Shape of a locale bundle contributed via PR (locales/<code>.json). A bundle may translate any subset of the keys under 'strings' — missing keys fall back to English at runtime, so a bundle never needs to be complete to be valid or useful.",
  "type": "object",
  "required": ["meta", "strings"],
  "additionalProperties": false,
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "strings": { "$ref": "#/$defs/strings" }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": ["code", "endonym", "englishName", "direction", "targetsVersion"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-[A-Z]{2})?$",
          "description": "BCP 47 language tag, e.g. \"ar\", \"pt-BR\"."
        },
        "endonym": {
          "type": "string",
          "description": "The language's own name for itself, e.g. \"العربية\" — shown in the language picker."
        },
        "englishName": {
          "type": "string",
          "description": "English name of the language, for contributors and as a fallback label."
        },
        "direction": {
          "enum": ["ltr", "rtl"],
          "description": "Self-declared text direction. Not inferred from the runtime's Intl support, so any script works without platform assumptions."
        },
        "targetsVersion": {
          "type": "string",
          "description": "Which locales/en.js STRINGS_VERSION this bundle was written against. Informational — used to flag a bundle as possibly stale, never to reject it."
        }
      }
    },
    "strings": {
      "type": "object",
      "description": "Dot-path-addressed nested string tree. Any key may be omitted; omitted keys fall back to English per-key at runtime (src/i18n.js translate()).",
      "additionalProperties": false,
      "properties": {
        "ui": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "docTitle": { "type": "string" },
            "metaDescription": { "type": "string" },
            "languageLabel": { "type": "string" },
            "skipLink": { "type": "string" },
            "heading": { "type": "string" },
            "subtitle": { "type": "string" },
            "navHeading": { "type": "string" },
            "navRabiLabel": { "type": "string" },
            "navRabiNote": { "type": "string" },
            "navDesignLabel": { "type": "string" },
            "navDesignNote": { "type": "string" }
          }
        },
        "hero": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "blochCaption": { "type": "string" }
          }
        },
        "purpose": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "heading": { "type": "string" },
            "body": { "type": "string" }
          }
        },
        "rabiProblem": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "heading": { "type": "string" },
            "body": { "type": "string" }
          }
        },
        "ramseyPayoff": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "heading": { "type": "string" },
            "body": { "type": "string" }
          }
        },
        "coherenceBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "heading": { "type": "string" },
            "body": { "type": "string" }
          }
        },
        "diagram": {
          "type": "object",
          "description": "Static markup for the aria-hidden Rabi-vs-Ramsey timeline SVG plus its sr-only prose equivalent.",
          "additionalProperties": false,
          "properties": {
            "heading": { "type": "string" },
            "rabiCaption": { "type": "string" },
            "rabiOnLabel": { "type": "string" },
            "ramseyCaption": { "type": "string" },
            "ramseyPulseLabel": { "type": "string" },
            "ramseyWaitLabel": { "type": "string" },
            "rabiLinkLabel": { "type": "string" },
            "ramseyLinkLabel": { "type": "string" },
            "srDescription": { "type": "string" }
          }
        },
        "footer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "physicsNote": { "type": "string" },
            "companionNote": { "type": "string" }
          }
        }
      }
    }
  }
}
